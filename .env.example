# Copy this file to .env and fill in real values for local testing.
# In production (GitHub Actions) these are set as encrypted repo secrets instead —
# see .github/workflows/job-search.yml.
#
# NOTE: no ANTHROPIC_API_KEY here on purpose. Tailoring runs through the Claude
# Code CLI against your Claude subscription (Pro/Max) via CLAUDE_CODE_OAUTH_TOKEN
# instead of metered API billing. Locally, if you're already logged into
# `claude` interactively, you don't need to set anything for this. For the
# GitHub Actions workflow, generate one with `claude setup-token` and add it as
# a repo secret (see README.md) — do not also set ANTHROPIC_API_KEY anywhere in
# that environment, since it would silently switch billing back to metered API.

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=au,gb,de,nl,at,fr,it,pl

JOOBLE_API_KEY=
THEMUSE_API_KEY=

# Direct-company job boards (no key needed) — comma-separated board tokens, found
# in each company's careers page URL: boards.greenhouse.io/<token>,
# jobs.lever.co/<token>, jobs.ashbyhq.com/<token>. Leave unset to use the
# built-in default pool (~76 companies, sourced from santifer/career-ops —
# mostly AI/ML companies, not .NET shops, but harmless since the .NET filter
# excludes irrelevant postings anyway). Set these explicitly to override with
# your own list instead.
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
ASHBY_COMPANIES=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_TO=

ENABLE_LINKEDIN_INDEED=false
JOB_QUERY=.NET developer
AI_JOB_QUERY=Agentic AI Engineer
